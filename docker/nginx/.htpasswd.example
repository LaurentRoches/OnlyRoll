# Fichier de référence pour le dev local.
# Ne JAMAIS commiter le vrai .htpasswd (il est dans .gitignore).
#
# Générer le fichier .htpasswd avec l'une de ces commandes :
#   htpasswd -nb <USER> <PASSWORD> > docker/nginx/.htpasswd
#   echo "<USER>:$(openssl passwd -apr1 <PASSWORD>)" > docker/nginx/.htpasswd
#
# Exemple (remplacer les valeurs) :
admin:$apr1$REPLACEME$REPLACEMEPLACEHOLDER00000000000
