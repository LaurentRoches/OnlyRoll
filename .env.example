# ===========================================
# ONLYROLL - FICHIER DE CONFIGURATION
# ===========================================
# Copiez ce fichier vers .env et modifiez les valeurs selon votre environnement
# cp .env.example .env
#
# ATTENTION: Ne jamais committer le fichier .env avec des secrets de production!

# ===========================================
# ENVIRONNEMENT
# ===========================================
# dev | prod | test
APP_ENV=dev
APP_DEBUG=true
# Changez cette valeur en production (générez avec: php -r "echo bin2hex(random_bytes(16));")
APP_SECRET=your-app-secret-change-in-production
DEFAULT_URI=http://localhost

# ===========================================
# DATABASE (MySQL)
# ===========================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?serverVersion=8.0&charset=utf8mb4
#
# Developpement (Docker):
DATABASE_URL="mysql://onlyroll_db:onlyroll_docker_pass@mysql:3306/onlyroll_db?serverVersion=8.0&charset=utf8mb4"
#
# Production (exemple):
# DATABASE_URL="mysql://prod_user:STRONG_PASSWORD@localhost:3306/onlyroll_prod?serverVersion=8.0&charset=utf8mb4"

# Credentials MySQL (utilisees par Docker pour initialiser la base)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=onlyroll_db
MYSQL_PASSWORD=onlyroll_docker_pass
MYSQL_DATABASE=onlyroll_db

# ===========================================
# JWT (Lexik Authentication)
# ===========================================
# Chemins vers les cles JWT (generees avec: php bin/console lexik:jwt:generate-keypair)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Passphrase utilisee pour generer les cles (changez en production)
JWT_PASSPHRASE=dev_passphrase_only

# ===========================================
# CORS (Nelmio CORS Bundle)
# ===========================================
# Origine autorisee pour les requetes cross-origin
# Developpement:
CORS_ALLOW_ORIGIN=http://localhost:5173
# Production (exemple):
# CORS_ALLOW_ORIGIN=https://onlyroll.cloud

# ===========================================
# MERCURE (WebSocket Hub)
# ===========================================
# URL interne (backend -> Mercure)
MERCURE_URL=http://mercure:3000/.well-known/mercure
# URL publique (frontend -> Mercure)
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# Secret JWT pour Mercure (minimum 256 bits / 32 bytes pour HMAC SHA256)
# Generez avec: openssl rand -base64 32
MERCURE_JWT_SECRET=your-mercure-secret-change-in-production

# ===========================================
# REDIS (Cache et Sessions)
# ===========================================
# Developpement (Docker):
REDIS_URL=redis://redis:6379
# Production avec mot de passe (exemple):
# REDIS_URL=redis://default:REDIS_PASSWORD@redis:6379

# ===========================================
# FRONTEND (Vue.js + Vite)
# ===========================================
# URL de l'API backend
VITE_API_URL=http://localhost/api
# URL WebSocket
VITE_WS_URL=ws://localhost:3000
# URL Mercure publique
VITE_MERCURE_URL=http://localhost:3000/.well-known/mercure

# Informations de l'application
VITE_APP_NAME=OnlyRoll
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# URLs supplementaires
VITE_TERMS_URL=/terms
VITE_PRIVACY_URL=/privacy
VITE_SUPPORT_EMAIL=support@onlyroll.com

# ===========================================
# DOCKER COMPOSE - PORTS EXPOSES
# ===========================================
NGINX_PORT=80
FRONTEND_PORT=5173
MERCURE_PORT=3000
DB_PORT=3306
REDIS_PORT=6379

# Identifiant du projet Docker
COMPOSE_PROJECT_NAME=onlyroll

# ===========================================
# PRODUCTION UNIQUEMENT
# ===========================================
# Ces variables sont utilisees uniquement en production (docker-compose.prod.yml)
#
# Domaine de production:
# DEFAULT_URI=https://onlyroll.cloud
# CORS_ALLOW_ORIGIN=https://onlyroll.cloud
# MERCURE_PUBLIC_URL=https://onlyroll.cloud/.well-known/mercure
# VITE_API_URL=https://onlyroll.cloud/api
# VITE_WS_URL=wss://onlyroll.cloud:3000
# VITE_MERCURE_URL=https://onlyroll.cloud/.well-known/mercure

# ===========================================
# CHECKLIST AVANT MISE EN PRODUCTION
# ===========================================
# [ ] APP_ENV=prod
# [ ] APP_DEBUG=false
# [ ] APP_SECRET genere aleatoirement
# [ ] MYSQL_ROOT_PASSWORD fort et unique
# [ ] MYSQL_PASSWORD fort et unique
# [ ] JWT_PASSPHRASE fort et unique
# [ ] MERCURE_JWT_SECRET genere avec openssl rand -base64 32
# [ ] Cles JWT generees (lexik:jwt:generate-keypair)
# [ ] CORS_ALLOW_ORIGIN = domaine de production uniquement
# [ ] URLs VITE_* pointent vers le domaine de production
# [ ] Certificats SSL configures (Let's Encrypt / Certbot)
